include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
recursive-include src *.py
recursive-include config *.toml
recursive-include examples *.json
recursive-include docs *.md
recursive-include .specs *.md
recursive-include installer *.sh
recursive-include integrations *
recursive-include packaging *
recursive-include skills *
recursive-include tests_core *.py
recursive-include tests_consumers *.py
recursive-include tests_packaging *.py
prune capture
prune capture_v2
prune curation
prune migration
prune mirror
prune second_brain
prune tests
global-exclude *.py[cod]
global-exclude *.sqlite*

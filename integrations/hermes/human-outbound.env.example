# Inert example. Replace every /absolute path and ID before loading it.
ESPELHO_ZAP_TELEGRAM_FORUM_CHAT_ID=-1000000000000
ESPELHO_ZAP_HUMAN_OUTBOUND_ENABLED=enabled
ESPELHO_ZAP_HUMAN_OUTBOUND_ALLOWED_USERS=0000000000
ESPELHO_ZAP_HUMAN_OUTBOUND_ROUTE_MAP=/absolute/private/route-map.json
ESPELHO_ZAP_HUMAN_OUTBOUND_TOKEN_FILE=/absolute/private/human-outbound.token
ESPELHO_ZAP_HUMAN_OUTBOUND_LEDGER=/absolute/private/mirror.sqlite3
ESPELHO_ZAP_HUMAN_OUTBOUND_MIRROR_LEDGER=/absolute/private/espelho-zap.sqlite3
ESPELHO_ZAP_HUMAN_OUTBOUND_MANAGED_MEDIA_ROOT=/absolute/private/human-outbound-media
ESPELHO_ZAP_HUMAN_OUTBOUND_ARM_FILE=/absolute/private/human-outbound.arm.json
ESPELHO_ZAP_HUMAN_OUTBOUND_STARTUP_MARKER=/absolute/private/human-outbound.startup.json
ESPELHO_ZAP_RELEASE_COMMIT=0000000000000000000000000000000000000000
ESPELHO_ZAP_HUMAN_OUTBOUND_TIMEOUT_SECONDS=70
